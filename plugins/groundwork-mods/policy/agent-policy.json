{
  "version": 1,
  "mode": "read-only",
  "draftFolders": ["drafts"],
  "neverWrite": [".groundwork"],
  "send": {
    "commands": [
      "git push", "gh pr create", "gh pr merge", "gh pr comment", "gh issue create",
      "gh issue comment", "gh release create", "npm publish", "twine upload",
      "curl -x post", "curl --request post", "invoke-restmethod", "-method post",
      "sendmail", "scp ", "rsync "
    ],
    "toolWords": [
      "send", "post", "publish", "reply", "tweet", "email", "mail", "schedule",
      "forward", "submit", "broadcast", "notify", "invite"
    ]
  },
  "draftWords": ["draft"],
  "delete": {
    "commands": [
      "rm ", "rmdir", "del ", "erase ", "remove-item", "git clean", "git branch -d",
      "git reset --hard", "shred", "unlink"
    ],
    "toolWords": ["delete", "remove", "trash", "destroy", "purge", "drop", "archive"],
    "approvers": [],
    "approvalFile": ".groundwork/approvals.json"
  },
  "readOnlyCommands": [
    "git status", "git log", "git diff", "git show", "git rev-parse", "git ls-files",
    "git rev-list", "git describe", "git blame", "git shortlog",
    "git stash list", "git config --get",
    "cd", "set-location", "pushd", "popd", "ls", "dir", "cat", "type", "pwd", "echo", "head",
    "tail", "wc", "cut", "diff", "stat", "du", "df", "basename", "dirname", "realpath",
    "whoami", "true", "false", "test", "grep", "rg", "findstr",
    "get-childitem", "get-item", "get-content", "get-location", "get-date", "get-command",
    "get-filehash", "resolve-path", "split-path", "join-path", "select-string", "test-path",
    "measure-object", "select-object", "where-object", "sort-object", "format-list",
    "format-table", "which", "where"
  ],
  "readOnlyExact": [
    "git branch", "git branch --list", "git branch -a", "git branch -r", "git branch -v",
    "git branch -vv", "git branch --show-current", "git remote -v", "python --version",
    "py -3 --version", "node --version"
  ],
  "blockedArgs": [
    "--output", "--ext-diff", "--upload-pack", "--pre", "--textconv", "--exec-path",
    "--hostname-bin", "--search-zip"
  ],
  "readWords": ["get", "list", "read", "search", "query", "fetch", "find", "show", "describe", "view", "lookup", "count"],
  "log": ".groundwork/agent-log.ndjson",
  "undoFolder": ".groundwork/undo"
}
